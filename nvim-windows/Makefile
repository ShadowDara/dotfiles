# Install Stuff for the NVIM Setup

install:
		sudo apt update
		
		sudo apt install clangd clang build-essential cmake cargo rustc build-essential pkg-config libfontconfig1-dev tree-sitter-cli
		
		sudo apt install -y \
  		libxcb-render0-dev \
  		libxcb1-dev \
  		libx11-dev \
  		libfontconfig1-dev \
  		libfreetype6-dev
		
		sudo apt update
		
		sudo apt install --reinstall -y \
  		libxcb-shape0-dev \
  		libxcb-xfixes0-dev \
  		libxcb-render0-dev \
  		libxcb1-dev
		
		cargo install silicon

